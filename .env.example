APP_NAME="SMVS Happy Family"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://happyfamily.example.org
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=happy_family
DB_USERNAME=happy_family
DB_PASSWORD=
DB_SSLMODE=prefer
PGCONNECT_TIMEOUT=5

# Keep normal HTTP sessions/cache independent from Redis so a queue outage
# cannot take down login. Database-backed sessions/cache avoid filesystem
# permission drift across container recreates and work correctly with replicas.
CACHE_STORE=database
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_TABLE=sessions
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=public

SUPER_ADMIN_NAME="SMVS Super Admin"
SUPER_ADMIN_EMAIL=admin@example.org
SUPER_ADMIN_PASSWORD=

# Optional local/UAT pilot data. Keep false in production.
PILOT_DATA=false
PILOT_PASSWORD=

# Runtime self-healing. The watchdog uses a dedicated health FPM pool and
# Laravel's middleware-light /up route, so busy normal workers and DB/Redis
# dependency outages do not create false web-container restarts.
WEB_WATCHDOG_ENABLED=true
WEB_WATCHDOG_URL=http://127.0.0.1/__laravel_health
WEB_WATCHDOG_INTERVAL_SECONDS=15
WEB_WATCHDOG_TIMEOUT_SECONDS=4
WEB_WATCHDOG_FAILURE_THRESHOLD=4
WEB_WATCHDOG_START_GRACE_SECONDS=60
WEB_PROCESS_RESTART_MAX=5
WEB_PROCESS_RESTART_WINDOW_SECONDS=600
WEB_PROCESS_STOP_GRACE_SECONDS=5
WEB_PROCESS_RESTART_BACKOFF_SECONDS=2
WEB_PROCESS_RESTART_MAX_BACKOFF_SECONDS=20
WEB_INFRA_PROBE_INTERVAL_SECONDS=10
WEB_INFRA_PROBE_TIMEOUT_SECONDS=3
WEB_INFRA_PROBE_FAILURE_THRESHOLD=3
RUNTIME_LOG_MAX_BYTES=5242880

# Background supervisors keep the queue worker and scheduler container alive
# across intentional recycling or transient child-process crashes.
BACKGROUND_RESTART_BACKOFF_SECONDS=3
BACKGROUND_RESTART_MAX_BACKOFF_SECONDS=30
BACKGROUND_STABLE_RESET_SECONDS=300
BACKGROUND_LOG_MAX_BYTES=5242880

# Container resource safety caps. These are limits, not reservations, and may be
# raised for a larger Coolify host after measuring real usage.
WEB_MEMORY_LIMIT=1280m
WEB_PIDS_LIMIT=256
WORKER_MEMORY_LIMIT=448m
WORKER_PIDS_LIMIT=192
SCHEDULER_MEMORY_LIMIT=192m
SCHEDULER_PIDS_LIMIT=128
DB_MEMORY_LIMIT=768m
DB_PIDS_LIMIT=256
DB_SHM_SIZE=256m
REDIS_MEMORY_LIMIT=256m
REDIS_PIDS_LIMIT=128
REDIS_MAXMEMORY=160mb

# Conservative PostgreSQL runtime defaults.
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_WORK_MEM=2MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_STATEMENT_TIMEOUT=120000
POSTGRES_IDLE_TX_TIMEOUT=60000
REDIS_QUEUE_RETRY_AFTER=1200

# Readiness guard: /health/ready becomes degraded before disk exhaustion.
HEALTH_MIN_DISK_FREE_MB=512
