APP_NAME="SMVS Happy Family"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://happyfamily.example.org
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=happy_family
DB_USERNAME=happy_family
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=public

SUPER_ADMIN_NAME="SMVS Super Admin"
SUPER_ADMIN_EMAIL=admin@example.org
SUPER_ADMIN_PASSWORD=

# Optional local/UAT pilot data. Keep false in production.
PILOT_DATA=false
PILOT_PASSWORD=
